{
  "name": "rollixia-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('server')){cp.execSync('npm --prefix server install',{stdio:'inherit'})}\"",
    "build": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('client')){cp.execSync('npm --prefix client install && npm --prefix client run build',{stdio:'inherit'})}else{cp.execSync('npm run build',{stdio:'inherit'})}\"",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dunder-proto": "^1.0.1",
    "express": "^4.21.2",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.5",
    "multer": "^1.4.5-lts.1",
    "paytmchecksum": "^1.5.1",
    "razorpay": "^2.9.8",
    "sql.js": "^1.12.0"
  }
}
